{
  "name": "dom-desktop",
  "version": "1.0.0",
  "description": "Independent Chromium research sessions and controlled DOM navigation testing",
  "author": "0xSkyler",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/tests/unit",
    "test:browser": "vitest run src/tests/browser --maxWorkers=1",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:browser && npm run test:integration && npm run build && npm run test:desktop",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "test:integration": "node scripts/integration-check.mjs",
    "test:dev": "npm run build && node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "type": "module",
  "desktopName": "dom.desktop",
  "productName": "DOM"
}
